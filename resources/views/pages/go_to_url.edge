{{--
  Page "Mes liens" : direction A "Feuille".
  Le contrôleur envoie "liens" : une liste déjà préparée
  (lien court complet, QR code, date lisible).
--}}
@layout({ title: 'Mes liens' })

  <div class="max-w-3xl mx-auto flex flex-col gap-10">

    {{-- ===== En-tête de la page ===== --}}
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="flex flex-col gap-2">
        <p class="font-display font-semibold text-xs tracking-[0.14em] text-graphite-doux">MES LIENS</p>
        <h1 class="font-display font-semibold text-3xl">
          {{-- Accord du pluriel : "1 lien" / "3 liens" --}}
          {{ liens.length }} {{ liens.length > 1 ? 'liens' : 'lien' }}
        </h1>
      </div>
      {{-- L'action principale de la page : la seule en bleu --}}
      <a href="{{ route('urls.home') }}" class="px-5 py-3 rounded-xl bg-calque text-white font-semibold hover:opacity-90">
        Nouveau lien
      </a>
    </div>

    {{-- Erreur éventuelle (ex. : tentative de supprimer le lien d'un autre) --}}
    @if(flashMessages.has('errors.destroy'))
      <p class="px-4 py-3 rounded-xl bg-papier-releve border border-trait text-erreur text-sm">
        {{ flashMessages.get('errors.destroy') }}
      </p>
    @end

    {{-- ===== La liste ===== --}}
    <div class="flex flex-col gap-4">
      @each(lien in liens)
        {{-- Une carte par lien : infos à gauche, QR code à droite --}}
        <article class="flex flex-wrap rounded-xl bg-papier-releve border border-trait">

          {{-- Partie gauche : les informations et les actions --}}
          <div class="flex-[999_1_320px] min-w-0 p-6 flex flex-col gap-4">

            {{-- Le lien court, en police code et en bleu --}}
            <a href="{{ lien.shortUrl }}" target="_blank" class="font-mono text-lg text-calque break-all hover:underline">
              {{ lien.shortUrl }}
            </a>

            {{-- L'adresse d'origine, plus discrète (tronquée si trop longue) --}}
            <div class="flex flex-col gap-1">
              <p class="text-[13px] font-medium text-graphite-doux">Adresse d'origine · créé le {{ lien.createdAt }}</p>
              <p class="text-[15px] text-graphite-doux truncate" title="{{ lien.originalUrl }}">{{ lien.originalUrl }}</p>
            </div>

            {{-- Les actions, séparées par un filet --}}
            <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-trait text-[15px]">
              {{-- data-copy : le script dans app.js copie ce texte au clic --}}
              <button type="button" data-copy="{{ lien.shortUrl }}"
                class="px-4 py-2 rounded-xl border border-trait font-medium hover:border-graphite cursor-pointer">
                Copier
              </button>

              <a href="{{ route('urls.edit', { id: lien.id }) }}" class="font-medium hover:text-calque">Modifier</a>

              {{-- Suppression : POST déguisé en DELETE, avec confirmation --}}
              <form action="{{ route('urls.destroy', { id: lien.id }) }}?_method=DELETE" method="POST"
                onsubmit="return confirm('Supprimer ce lien ?')">
                {{ csrfField() }}
                <button type="submit" class="font-medium text-erreur hover:underline cursor-pointer">Supprimer</button>
              </form>
            </div>
          </div>

          {{-- Partie droite : le QR code, généré par notre serveur --}}
          <div class="flex-[1_1_180px] p-6 border-l border-trait flex flex-col items-center justify-center gap-3">
            <img src="{{ lien.qrCode }}" alt="QR code du lien {{ lien.shortCode }}" class="w-32 h-32">
            {{-- L'attribut download fait télécharger l'image au lieu de l'ouvrir --}}
            <a href="{{ lien.qrCode }}" download="qr-{{ lien.shortCode }}.png" class="text-[13px] font-medium text-calque hover:underline">
              Télécharger le QR code
            </a>
          </div>
        </article>

      @else
        {{-- @else d'un @each : affiché quand la liste est vide --}}
        <div class="py-16 text-center flex flex-col items-center gap-3 border border-dashed border-trait rounded-xl">
          <p class="font-display font-semibold text-xl">Aucun lien pour l'instant</p>
          <p class="text-graphite-doux">Crée ton premier lien court depuis l'accueil.</p>
        </div>
      @end
    </div>

  </div>

@end