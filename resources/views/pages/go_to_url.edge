<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tester mon URL & Historique</title>

    {{-- Chargement CSS/JS avec Vite --}}
    @vite(['resources/css/app.css', 'resources/js/app.js'])
</head>
<body class="bg-gray-100 min-h-screen p-6 font-sans">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">

    <!-- 1. ZONE PRINCIPALE : Zone de test -->
        <main class="md:col-span-1 bg-white shadow-md rounded-xl p-6 h-fit">
            <h1 class="text-2xl font-bold text-gray-800 mb-2">Tester une URL courte</h1>
            <p class="text-sm text-gray-600 mb-4">
                Tapez votre code court ci-dessous pour tester la redirection :
            </p>

            <input
                type="text"
                id="testCode"
                placeholder="ex: mon-lien"
                class="w-full border border-gray-300 rounded-lg px-3 py-2 mb-3 focus:outline-none focus:ring-2 focus:ring-blue-500">
            <button
                onclick="window.open('/' + document.getElementById('testCode').value, '_blank')"
                class="w-full bg-blue-600 text-white font-semibold py-2 rounded-lg hover:bg-blue-700 transition">
                Accéder
            </button>

            <hr class="my-6 border-gray-200">

            <a href="{{ route('urls.home') }}" class="text-sm text-blue-600 hover:underline inline-block">
                ← Retour au formulaire d'accueil
            </a>
        </main>

    <!-- 2. SIDEBAR : Historique dynamique des liens -->
        <aside class="md:col-span-2 bg-white shadow-md rounded-xl p-6">
            <h2 class="text-xl font-bold text-gray-800 mb-4">Historique des liens</h2>

            <div class="space-y-4">
            @each(url in urls)
                <div class="border border-gray-200 rounded-lg p-4 flex items-center justify-between gap-4">

            <div class="flex-1 min-w-0">
                <p class="text-sm text-gray-800">
                <strong>Code court :</strong> {{ url.shortCode }}
                </p>
                <p class="text-sm text-gray-800 truncate">
                    <strong>URL Cible :</strong>
                    <a href="{{ url.originalUrl }}" target="_blank" class="text-blue-600 hover:underline">
                    {{ url.originalUrl }}
                    </a>
                </p>

            <form action="{{ route('urls.destroy', { id: url.id }) }}" method="POST" class="mt-2">
                {{ csrfField() }}
                <button type="submit" class="text-sm text-red-600 hover:underline font-medium">
                    Supprimer
                </button>
            </form>
                
            </div>

            <!-- QR Code dynamique -->
            <div class="shrink-0">
                <img
                src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data={{ url.originalUrl }}"
                alt="QR Code pour {{ url.shortCode }}"
                class="w-24 h-24 rounded border border-gray-200">
            </div>

            </div>
            @else
            <p class="text-sm text-gray-500">Aucune URL enregistrée pour le moment.</p>
            @endeach
            </div>

        </aside>

    </div>

</body>
</html>