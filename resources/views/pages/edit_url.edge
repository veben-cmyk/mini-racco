{{-- Modification d'un lien : direction A --}}
@layout({ title: 'Modifier un lien' })

  <div class="max-w-md mx-auto flex flex-col gap-8">

    <div class="flex flex-col items-center gap-3 text-center">
      <p class="font-display font-semibold text-xs tracking-[0.14em] text-graphite-doux">MODIFIER</p>
      {{-- On rappelle quel lien est en cours de modification --}}
      <h1 class="font-display font-semibold text-3xl break-all">/{{ shortUrl.shortCode }}</h1>
    </div>

    {{-- POST déguisé en PUT grâce à ?_method=PUT --}}
    <form action="{{ route('urls.update', { id: shortUrl.id }) }}?_method=PUT" method="POST"
      class="flex flex-col gap-5 p-8 rounded-xl bg-papier-releve border border-trait">
      {{ csrfField() }}

      {{-- URL d'origine : pré-remplie avec la valeur actuelle --}}
      <div class="flex flex-col gap-2">
        <label for="url" class="text-[13px] font-medium text-graphite-doux">Adresse d'origine</label>
        {{-- Après une erreur : la valeur tapée (old). Sinon : la valeur en base. --}}
        <input type="url" id="url" name="url" required
          value="{{ old('url') || shortUrl.originalUrl }}"
          class="px-4 py-3 rounded-xl bg-papier-releve border border-trait outline-none focus:border-calque focus:ring-2 focus:ring-calque/20">
        @inputError('url')
          @each(message in $messages)
            <p class="text-[13px] text-erreur">{{ message }}</p>
          @end
        @end
      </div>

      {{-- Code court : avec le préfixe, comme sur l'accueil --}}
      <div class="flex flex-col gap-2">
        <label for="shortCode" class="text-[13px] font-medium text-graphite-doux">Code court</label>
        <div class="flex items-center rounded-xl bg-papier-releve border border-trait focus-within:border-calque focus-within:ring-2 focus-within:ring-calque/20">
          <span class="pl-4 font-mono text-sm text-graphite-doux">{{ request.host() }}/</span>
          <input type="text" id="shortCode" name="shortCode" required
            value="{{ old('shortCode') || shortUrl.shortCode }}"
            class="flex-1 min-w-0 pr-4 py-3 bg-transparent font-mono text-[15px] outline-none">
        </div>
        @inputError('shortCode')
          @each(message in $messages)
            <p class="text-[13px] text-erreur">{{ message }}</p>
          @end
        @end
      </div>

      <button type="submit" class="mt-2 py-3 rounded-xl bg-calque text-white font-semibold hover:opacity-90 cursor-pointer">
        Enregistrer
      </button>
    </form>

    {{-- Annuler : retour à la liste sans rien changer --}}
    <a href="{{ route('urls.goToUrl') }}" class="text-center text-[15px] text-graphite-doux hover:text-graphite">
      ← Annuler et revenir à mes liens
    </a>
  </div>

@end