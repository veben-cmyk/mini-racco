{{-- Page d'inscription : direction A, même structure que la connexion --}}
@layout({ title: 'Créer un compte' })

  <div class="max-w-md mx-auto flex flex-col gap-8">

    <div class="flex flex-col items-center gap-3 text-center">
      <p class="font-display font-semibold text-xs tracking-[0.14em] text-graphite-doux">INSCRIPTION</p>
      <h1 class="font-display font-semibold text-3xl">Crée ton compte.</h1>
    </div>

    <form action="/register" method="POST" class="flex flex-col gap-5 p-8 rounded-xl bg-papier-releve border border-trait">
      {{ csrfField() }}

      {{-- Nom d'utilisateur --}}
      <div class="flex flex-col gap-2">
        <label for="username" class="text-[13px] font-medium text-graphite-doux">Nom d'utilisateur</label>
        <input type="text" id="username" name="username" required autocomplete="username"
          value="{{ old('username') || '' }}" placeholder="jaden"
          class="px-4 py-3 rounded-xl bg-papier-releve border border-trait outline-none focus:border-calque focus:ring-2 focus:ring-calque/20">
        {{-- Messages de l'inspecteur pour cette case --}}
        @inputError('username')
          @each(message in $messages)
            <p class="text-[13px] text-erreur">{{ message }}</p>
          @end
        @end
      </div>

      {{-- Email --}}
      <div class="flex flex-col gap-2">
        <label for="email" class="text-[13px] font-medium text-graphite-doux">Adresse email</label>
        <input type="email" id="email" name="email" required autocomplete="email"
          value="{{ old('email') || '' }}" placeholder="nom@exemple.com"
          class="px-4 py-3 rounded-xl bg-papier-releve border border-trait outline-none focus:border-calque focus:ring-2 focus:ring-calque/20">
        @inputError('email')
          @each(message in $messages)
            <p class="text-[13px] text-erreur">{{ message }}</p>
          @end
        @end
      </div>

      {{-- Mot de passe --}}
      <div class="flex flex-col gap-2">
        <label for="password" class="text-[13px] font-medium text-graphite-doux">Mot de passe</label>
        <input type="password" id="password" name="password" required autocomplete="new-password"
          class="px-4 py-3 rounded-xl bg-papier-releve border border-trait outline-none focus:border-calque focus:ring-2 focus:ring-calque/20">
        {{-- Indication affichée en permanence, pour éviter l'erreur avant qu'elle arrive --}}
        <p class="text-[13px] text-graphite-doux">8 caractères minimum.</p>
        @inputError('password')
          @each(message in $messages)
            <p class="text-[13px] text-erreur">{{ message }}</p>
          @end
        @end
      </div>

      <button type="submit" class="mt-2 py-3 rounded-xl bg-calque text-white font-semibold hover:opacity-90 cursor-pointer">
        Créer mon compte
      </button>
    </form>

    <p class="text-center text-[15px] text-graphite-doux">
      Déjà un compte ?
      <a href="/login" class="text-calque font-medium hover:underline">Se connecter</a>
    </p>
  </div>

@end