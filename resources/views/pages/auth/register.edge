<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inscription - Mini Racco</title>
  @vite(['resources/css/app.css', 'resources/js/app.js'])
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex items-center justify-center p-6">

  <div class="w-full max-w-md bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
    
    <!-- En-tête -->
    <div class="text-center mb-8">
        <h1 class="text-2xl font-bold text-slate-900 mb-1">Créer un compte</h1>
        <p class="text-sm text-slate-500">Rejoignez Mini Racco pour gérer vos liens</p>
    </div>

        {{-- Messages de l'inspecteur, une case après l'autre --}}
    @inputError('username')
      @each(message in $messages)
        <div class="mb-3 p-3 bg-red-50 border border-red-200 text-red-600 rounded-lg text-sm">{{ message }}</div>
      @end
    @end

    @inputError('email')
      @each(message in $messages)
        <div class="mb-3 p-3 bg-red-50 border border-red-200 text-red-600 rounded-lg text-sm">{{ message }}</div>
      @end
    @end

    @inputError('password')
      @each(message in $messages)
        <div class="mb-3 p-3 bg-red-50 border border-red-200 text-red-600 rounded-lg text-sm">{{ message }}</div>
      @end
    @end

    <!-- Formulaire d'inscription -->
    <form action="/register" method="POST" class="space-y-5">
        {{ csrfField() }}

        <div>
        <label for="username" class="block text-sm font-semibold text-slate-700 mb-1.5">
            Nom d'utilisateur
        </label>
        <input 
            type="text" 
            id="username" 
            name="username" 
            placeholder="ex: jaden" 
            required
            class="w-full px-4 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-indigo-600 focus:ring-2 focus:ring-indigo-100 transition-all">
        </div>

        <div>
        <label for="email" class="block text-sm font-semibold text-slate-700 mb-1.5">
            Adresse email
        </label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          placeholder="nom@exemple.com" 
          required
          class="w-full px-4 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-indigo-600 focus:ring-2 focus:ring-indigo-100 transition-all"
        >
      </div>

      <div>
        <label for="password" class="block text-sm font-semibold text-slate-700 mb-1.5">
          Mot de passe
        </label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          placeholder="••••••••" 
          required
          class="w-full px-4 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-indigo-600 focus:ring-2 focus:ring-indigo-100 transition-all"
        >
      </div>

      <button 
        type="submit" 
        class="w-full py-3 px-4 bg-blue-600 hover:bg-indigo-700 text-white font-semibold rounded-lg text-sm transition-colors shadow-sm mt-2"
      >
        S'inscrire
      </button>
    </form>

    <!-- Pied de carte -->
    <div class="mt-6 text-center text-sm text-slate-500">
      Déjà un compte ? 
      <a href="/login" class="text-indigo-600 font-semibold hover:underline ml-1">
        Se connecter
        </a>
    </div>

  </div>

</body>
</html>