{{-- Page "Nouveau mot de passe" : on y arrive en cliquant le lien de l'email --}}
@layout({ title: 'Nouveau mot de passe' })

  <div class="max-w-md mx-auto flex flex-col gap-8">

    <div class="flex flex-col items-center gap-3 text-center">
      <p class="font-display font-semibold text-xs tracking-[0.14em] text-graphite-doux">NOUVEAU MOT DE PASSE</p>
      <h1 class="font-display font-semibold text-3xl">Choisis-en un nouveau.</h1>
    </div>

    {{-- Le jeton reçu dans le lien repart dans l'adresse du formulaire --}}
    <form action="{{ route('password.update', { token }) }}" method="POST"
      class="flex flex-col gap-5 p-8 rounded-xl bg-papier-releve border border-trait">
      {{ csrfField() }}

      <div class="flex flex-col gap-2">
        <label for="password" class="text-[13px] font-medium text-graphite-doux">Nouveau mot de passe</label>
        <input type="password" id="password" name="password" required autocomplete="new-password"
          class="px-4 py-3 rounded-xl bg-papier-releve border border-trait outline-none focus:border-calque focus:ring-2 focus:ring-calque/20">
        <p class="text-[13px] text-graphite-doux">8 caractères minimum.</p>
        @inputError('password')
          @each(message in $messages)
            <p class="text-[13px] text-erreur">{{ message }}</p>
          @end
        @end
      </div>

      <div class="flex flex-col gap-2">
        <label for="password_confirmation" class="text-[13px] font-medium text-graphite-doux">Confirme le mot de passe</label>
        {{-- Le nom "password_confirmation" est celui qu'attend la règle confirmed() --}}
        <input type="password" id="password_confirmation" name="password_confirmation" required autocomplete="new-password"
          class="px-4 py-3 rounded-xl bg-papier-releve border border-trait outline-none focus:border-calque focus:ring-2 focus:ring-calque/20">
      </div>

      <button type="submit" class="mt-2 py-3 rounded-xl bg-calque text-white font-semibold hover:opacity-90 cursor-pointer">
        Enregistrer
      </button>
    </form>
  </div>

@end