{{-- Page de connexion : direction A, carte centrée --}}
@layout({ title: 'Connexion' })

  <div class="max-w-md mx-auto flex flex-col gap-8">

    {{-- Titre --}}
    <div class="flex flex-col items-center gap-3 text-center">
      <p class="font-display font-semibold text-xs tracking-[0.14em] text-graphite-doux">CONNEXION</p>
      <h1 class="font-display font-semibold text-3xl">Bon retour.</h1>
    </div>

    {{-- La carte du formulaire --}}
    <form action="/login" method="POST" class="flex flex-col gap-5 p-8 rounded-xl bg-papier-releve border border-trait">
      {{ csrfField() }}

      {{-- Erreur de connexion (email ou mot de passe incorrect) --}}
      @if(flashMessages.has('errors.login'))
        <p class="text-[13px] text-erreur">{{ flashMessages.get('errors.login') }}</p>
      @end

      <div class="flex flex-col gap-2">
        <label for="email" class="text-[13px] font-medium text-graphite-doux">Adresse email</label>
        {{-- old('email') : on garde l'email tapé si la connexion échoue --}}
        <input type="email" id="email" name="email" required autocomplete="email"
          value="{{ old('email') || '' }}" placeholder="nom@exemple.com"
          class="px-4 py-3 rounded-xl bg-papier-releve border border-trait outline-none focus:border-calque focus:ring-2 focus:ring-calque/20">
      </div>

      <div class="flex flex-col gap-2">
        <label for="password" class="text-[13px] font-medium text-graphite-doux">Mot de passe</label>
        {{-- Jamais de old() sur un mot de passe : on ne le renvoie pas au navigateur --}}
        <input type="password" id="password" name="password" required autocomplete="current-password"
          class="px-4 py-3 rounded-xl bg-papier-releve border border-trait outline-none focus:border-calque focus:ring-2 focus:ring-calque/20">
      </div>

            {{-- Accès au parcours de réinitialisation --}}
      <a href="{{ route('password.forgot') }}" class="self-end -mt-2 text-[13px] text-calque hover:underline">
        Mot de passe oublié ?
      </a>

      <button type="submit" class="mt-2 py-3 rounded-xl bg-calque text-white font-semibold hover:opacity-90 cursor-pointer">
        Se connecter
      </button>
    </form>

    <p class="text-center text-[15px] text-graphite-doux">
      Pas encore de compte ?
      <a href="/register" class="text-calque font-medium hover:underline">Créer un compte</a>
    </p>
  </div>

@end