{{-- Page "Mot de passe oublié" : direction A, même structure que la connexion --}}
@layout({ title: 'Mot de passe oublié' })

  <div class="max-w-md mx-auto flex flex-col gap-8">

    <div class="flex flex-col items-center gap-3 text-center">
      <p class="font-display font-semibold text-xs tracking-[0.14em] text-graphite-doux">MOT DE PASSE OUBLIÉ</p>
      <h1 class="font-display font-semibold text-3xl">Pas de panique.</h1>
      <p class="text-graphite-doux">Indique ton adresse email : on t'envoie un lien pour choisir un nouveau mot de passe.</p>
    </div>

    <form action="{{ route('password.email') }}" method="POST"
      class="flex flex-col gap-5 p-8 rounded-xl bg-papier-releve border border-trait">
      {{ csrfField() }}

      {{-- Erreur venue d'un lien invalide ou expiré (envoyée par le contrôleur) --}}
      @if(flashMessages.has('errors.reset'))
        <p class="text-[13px] text-erreur">{{ flashMessages.get('errors.reset') }}</p>
      @end

      <div class="flex flex-col gap-2">
        <label for="email" class="text-[13px] font-medium text-graphite-doux">Adresse email</label>
        <input type="email" id="email" name="email" required autocomplete="email"
          value="{{ old('email') || '' }}" placeholder="nom@exemple.com"
          class="px-4 py-3 rounded-xl bg-papier-releve border border-trait outline-none focus:border-calque focus:ring-2 focus:ring-calque/20">
        @inputError('email')
          @each(message in $messages)
            <p class="text-[13px] text-erreur">{{ message }}</p>
          @end
        @end
      </div>

      <button type="submit" class="mt-2 py-3 rounded-xl bg-calque text-white font-semibold hover:opacity-90 cursor-pointer">
        Envoyer le lien
      </button>
    </form>

    <a href="/login" class="text-center text-[15px] text-graphite-doux hover:text-graphite">← Retour à la connexion</a>
  </div>

@end