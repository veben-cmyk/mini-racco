{{--
  Page d'accueil : direction A "Feuille".
  Tout ce qui est commun (head, navigation, pied de page, message de succès)
  vient du layout. Ici, seulement le contenu propre à cette page.
--}}
@layout({ title: 'Raccourcisseur' })

  <div class="max-w-2xl mx-auto flex flex-col items-center gap-12 text-center">

    {{-- ===== Titre ===== --}}
    <div class="flex flex-col items-center gap-4">
      {{-- Surtitre : petites capitales espacées, au-dessus du titre --}}
      <p class="font-display font-semibold text-xs tracking-[0.14em] text-graphite-doux">
        RACCOURCISSEUR D'URL
      </p>
      <h1 class="font-display font-semibold text-4xl sm:text-5xl leading-tight">
        Un lien long,<br>rendu court.
      </h1>
      <p class="max-w-md text-[17px] leading-relaxed text-graphite-doux">
        Colle une adresse, choisis un code si tu veux, et récupère un lien court prêt à partager.
      </p>
    </div>

    {{-- ===== Formulaire ===== --}}
    <form action="{{ route('urls.shorten') }}" method="POST" class="w-full flex flex-col gap-4 text-left">
      {{ csrfField() }}

      {{-- Case 1 : l'URL --}}
      <div class="flex flex-col gap-2">
        <label for="url" class="text-[13px] font-medium text-graphite-doux">Adresse à raccourcir</label>
        <input
          type="url"
          id="url"
          name="url"
          required
          value="{{ old('url') || '' }}"
          placeholder="https://exemple.com/un-lien-tres-long"
          class="w-full px-4 py-3 rounded-xl bg-papier-releve border border-trait text-[17px] outline-none focus:border-calque focus:ring-2 focus:ring-calque/20">
        {{-- Messages de l'inspecteur pour cette case --}}
        @inputError('url')
          @each(message in $messages)
            <p class="text-[13px] text-erreur">{{ message }}</p>
          @end
        @end
      </div>

      {{-- Case 2 : le code personnalisé (facultatif) --}}
      <div class="flex flex-col gap-2">
        <label for="shortCode" class="text-[13px] font-medium text-graphite-doux">
          Code personnalisé <span class="font-normal">(facultatif)</span>
        </label>
        {{-- Le préfixe montre à quoi ressemblera le lien final --}}
        <div class="flex items-center rounded-xl bg-papier-releve border border-trait focus-within:border-calque focus-within:ring-2 focus-within:ring-calque/20">
          <span class="pl-4 font-mono text-sm text-graphite-doux">{{ request.host() }}/</span>
          <input
            type="text"
            id="shortCode"
            name="shortCode"
            value="{{ old('shortCode') || '' }}"
            placeholder="mon-lien"
            class="flex-1 min-w-0 pr-4 py-3 bg-transparent font-mono text-[15px] outline-none">
        </div>
        @inputError('shortCode')
          @each(message in $messages)
            <p class="text-[13px] text-erreur">{{ message }}</p>
          @end
        @end
      </div>

      {{-- L'unique action en bleu de la page --}}
      <button type="submit" class="mt-2 w-full py-3 rounded-xl bg-calque text-white font-semibold hover:opacity-90 cursor-pointer">
        Raccourcir
      </button>

      {{-- Pour un visiteur : on le prévient qu'il faudra un compte --}}
      @if(!auth.user)
        <p class="text-center text-[13px] text-graphite-doux">
          Il faut un compte pour créer des liens.
          <a href="/login" class="text-calque hover:underline">Se connecter</a>
        </p>
      @end
    </form>

    {{-- ===== Trois points forts, séparés par un filet ===== --}}
    <div class="w-full grid grid-cols-1 sm:grid-cols-3 gap-6 pt-6 border-t border-trait text-left">
      <div>
        <p class="text-[15px] font-semibold">Court</p>
        <p class="text-[15px] text-graphite-doux">Un code facile à recopier.</p>
      </div>
      <div>
        <p class="text-[15px] font-semibold">À ton nom</p>
        <p class="text-[15px] text-graphite-doux">Choisis le code que tu veux.</p>
      </div>
      <div>
        <p class="text-[15px] font-semibold">À toi</p>
        <p class="text-[15px] text-graphite-doux">Retrouve et gère tes liens.</p>
      </div>
    </div>

  </div>

@end