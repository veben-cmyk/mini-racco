<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      AdonisJS - A fully featured web framework for Node.js
    </title>

    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link
      href="https://fonts.bunny.net/css?family=instrument-sans:400,400i,500,500i,600,600i,700,700i"
      rel="stylesheet"
    />

    <style>
      :root {
        --sand-1: #fdfdfc;
        --sand-2: #f9f9f8;
        --sand-3: #f1f0ef;
        --sand-4: #e9e8e6;
        --sand-5: #e2e1de;
        --sand-6: #dad9d6;
        --sand-7: #cfceca;
        --sand-8: #bcbbb5;
        --sand-9: #8d8d86;
        --sand-10: #82827c;
        --sand-11: #63635e;
        --sand-12: #21201c;
      }
    </style>

    <script src="https://cdn.tailwindcss.com">
      
    </script>

    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: [ "Instrument Sans", "sans-serif" ]
            },
            colors: {
              primary: {
                DEFAULT: "#5A45FF",
                lighter: "#a599ff"
              },
              sand: {
                1: "var(--sand-1)",
                2: "var(--sand-2)",
                3: "var(--sand-3)",
                4: "var(--sand-4)",
                5: "var(--sand-5)",
                6: "var(--sand-6)",
                7: "var(--sand-7)",
                8: "var(--sand-8)",
                9: "var(--sand-9)",
                10: "var(--sand-10)",
                11: "var(--sand-11)",
                12: "var(--sand-12)"
              }
            }
          }
        }
      };
    </script>

    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body class="min-h-screen w-screen font-sans bg-sand-2 flex items-center justify-center p-4">
    <header>
    </header>
    <main class="w-full max-w-md bg-white p-6 rounded-xl shadow-md text-center space-y-6">
      <div class="container mx-auto">
        <!-- 1. Titre de la page -->
      <div>
        <h1 class="text-2xl font-bold text-slate-800">
          Votre lien est prêt ! 🎉
        </h1>
        <p class="text-sm text-slate-500 mt-1">
          Voici le lien court et son QR code générés.
        </p>
      </div>

      <!-- 2. Affichage du Lien Court -->
      <div class="p-4 bg-slate-50 border border-slate-200 rounded-lg">
        <p class="text-xs font-semibold text-slate-400 uppercase">
          Lien court :
        </p>

       {{-- 
          EXPLICATION EDGE : 
          La double accolade {{ shortUrl }} permet d'afficher la valeur 
          de la variable envoyée depuis le contrôleur.
        --}}
        <a href="{{ shortUrl }}" target="_blank" class="text-lg font-bold text-indigo-600 underline break-all">
          {{ shortUrl }}
        </a>
      </div>

      <!-- 3. Affichage du QR Code (Conditionnel) -->
      {{-- 
        EXPLICATION EDGE : 
        La directive @if(qrCodeDataUrl) vérifie si la variable existe.
        Si oui, elle affiche le bloc HTML du QR Code. Sinon, elle le masque.
      --}}
      @if(qrCodeDataUrl)

      <div class="space-y-2">
          <p class="text-xs font-semibold text-slate-400 uppercase">
            QR Code associé :
          </p>
          <div class="inline-block p-2 bg-white border border-slate-200 rounded-lg">
            {{-- On injecte l'image base64 reçue du contrôleur --}}
            <img src="{{ qrCodeDataUrl }}" alt="QR Code" class="w-36 h-36" />
          </div>
        </div>
      @endif

      <!-- 4. Bouton pour recommencer -->
      <div class="pt-2">
        <a href="/" class="inline-block px-5 py-2.5 bg-indigo-600 text-white font-medium text-sm rounded-lg hover:bg-indigo-700">
          Raccourcir un autre lien
        </a>
      </div>
      </div>
    </main>
    <footer>
    </footer>
  </body>
</html>
